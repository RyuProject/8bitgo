{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "vite-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--port",
        "5179",
        "--strictPort"
      ],
      "port": 5179
    },
    {
      "name": "vite-web-prodapi",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "BACKEND_URL=https://8bitgo.com",
        "npx",
        "vite",
        "--port",
        "5180",
        "--strictPort"
      ],
      "port": 5180
    },
    {
      "name": "undertale-pages",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "wrangler",
        "pages",
        "dev",
        ".cloudflare-pages/undertale",
        "--port",
        "8796"
      ],
      "port": 8796
    },
    {
      "name": "gtavc-pages",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "wrangler",
        "pages",
        "dev",
        ".cloudflare-pages/gtavc",
        "--port",
        "8797"
      ],
      "port": 8797
    }
  ]
}
