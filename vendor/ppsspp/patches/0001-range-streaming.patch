diff --git a/Core/FileLoaders/WasmRangeFileLoader.h b/Core/FileLoaders/WasmRangeFileLoader.h
new file mode 100644
index 0000000..768a594
--- /dev/null
+++ b/Core/FileLoaders/WasmRangeFileLoader.h
@@ -0,0 +1,66 @@
+// Copyright (c) 2012- PPSSPP Project.
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#ifdef __EMSCRIPTEN__
+
+#include <atomic>
+#include <mutex>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+#include "Common/File/Path.h"
+#include "Core/Loaders.h"
+
+// Browser-only random-access loader.  A PSP ISO is commonly larger than the
+// WebAssembly heap budget, so retaining or downloading the entire object is
+// deliberately forbidden.  Reads are aligned to fixed 2 MiB HTTP ranges and
+// held in a bounded in-memory LRU.
+class WasmRangeFileLoader : public FileLoader {
+public:
+	explicit WasmRangeFileLoader(const Path &filename);
+	~WasmRangeFileLoader() override = default;
+
+	bool IsRemote() override { return true; }
+	bool Exists() override;
+	bool ExistsFast() override;
+	bool IsDirectory() override { return false; }
+	s64 FileSize() override;
+	Path GetPath() const override { return filename_; }
+
+	size_t ReadAt(s64 absolutePos, size_t bytes, size_t count, void *data, Flags flags = Flags::NONE) override;
+	size_t ReadAt(s64 absolutePos, size_t bytes, void *data, Flags flags = Flags::NONE) override;
+
+	void Cancel() override { cancelled_.store(true); }
+	std::string LatestError() const override;
+
+private:
+	struct CacheEntry {
+		std::vector<u8> bytes;
+		u64 usedAt = 0;
+	};
+
+	static constexpr s64 BLOCK_BYTES = 2 * 1024 * 1024;
+	static constexpr size_t MAX_CACHE_BYTES = 192 * 1024 * 1024;
+
+	void Prepare();
+	bool FetchRange(s64 offset, size_t length, std::vector<u8> *output, s64 *totalSize);
+	void SetError(const std::string &message);
+
+	Path filename_;
+	s64 fileSize_ = 0;
+	std::once_flag preparedFlag_;
+	std::atomic<bool> cancelled_{false};
+
+	std::mutex readMutex_;
+	std::unordered_map<s64, CacheEntry> cache_;
+	size_t cachedBytes_ = 0;
+	u64 clock_ = 0;
+
+	mutable std::mutex errorMutex_;
+	std::string latestError_;
+};
+
+#endif  // __EMSCRIPTEN__
diff --git a/Core/FileLoaders/WasmRangeFileLoader.cpp b/Core/FileLoaders/WasmRangeFileLoader.cpp
new file mode 100644
index 0000000..b04142a
--- /dev/null
+++ b/Core/FileLoaders/WasmRangeFileLoader.cpp
@@ -0,0 +1,216 @@
+// Copyright (c) 2012- PPSSPP Project.
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#ifdef __EMSCRIPTEN__
+
+#include "Core/FileLoaders/WasmRangeFileLoader.h"
+
+#include <algorithm>
+#include <cctype>
+#include <cstdio>
+#include <cstring>
+#include <limits>
+
+#include <emscripten/fetch.h>
+#include <emscripten/threading.h>
+
+#include "Common/Log.h"
+
+namespace {
+
+bool ParseContentRange(emscripten_fetch_t *fetch, s64 *first, s64 *last, s64 *total) {
+	const size_t length = emscripten_fetch_get_response_headers_length(fetch);
+	if (length == 0)
+		return false;
+
+	std::string headers(length + 1, '\0');
+	emscripten_fetch_get_response_headers(fetch, headers.data(), headers.size());
+	size_t at = 0;
+	while (at < headers.size()) {
+		size_t end = headers.find('\n', at);
+		if (end == std::string::npos)
+			end = headers.size();
+		std::string line = headers.substr(at, end - at);
+		std::transform(line.begin(), line.end(), line.begin(), [](unsigned char c) { return (char)std::tolower(c); });
+		long long parsedFirst = -1;
+		long long parsedLast = -1;
+		long long parsedTotal = -1;
+		if (std::sscanf(line.c_str(), "content-range: bytes %lld-%lld/%lld", &parsedFirst, &parsedLast, &parsedTotal) == 3) {
+			*first = (s64)parsedFirst;
+			*last = (s64)parsedLast;
+			*total = (s64)parsedTotal;
+			return true;
+		}
+		at = end + 1;
+	}
+	return false;
+}
+
+}  // namespace
+
+WasmRangeFileLoader::WasmRangeFileLoader(const Path &filename) : filename_(filename) {
+}
+void WasmRangeFileLoader::SetError(const std::string &message) {
+	std::lock_guard<std::mutex> guard(errorMutex_);
+	latestError_ = message;
+}
+
+std::string WasmRangeFileLoader::LatestError() const {
+	std::lock_guard<std::mutex> guard(errorMutex_);
+	return latestError_;
+}
+
+bool WasmRangeFileLoader::FetchRange(s64 offset, size_t length, std::vector<u8> *output, s64 *totalSize) {
+	if (offset < 0 || length == 0 || cancelled_.load())
+		return false;
+	if (emscripten_is_main_runtime_thread()) {
+		SetError("HTTP Range read reached the browser main thread");
+		ERROR_LOG(Log::Loader, "PPSSPP Range fetch must run in a pthread");
+		return false;
+	}
+
+	const s64 requestedLast = offset + (s64)length - 1;
+	const std::string rangeValue = "bytes=" + std::to_string(offset) + "-" + std::to_string(requestedLast);
+	const char *requestHeaders[] = {
+		"Range", rangeValue.c_str(),
+		"Accept", "application/octet-stream",
+		nullptr,
+	};
+
+	for (int attempt = 1; attempt <= 3 && !cancelled_.load(); ++attempt) {
+		emscripten_fetch_attr_t attr;
+		emscripten_fetch_attr_init(&attr);
+		std::strcpy(attr.requestMethod, "GET");
+		attr.attributes = EMSCRIPTEN_FETCH_LOAD_TO_MEMORY | EMSCRIPTEN_FETCH_SYNCHRONOUS;
+		attr.timeoutMSecs = 30000;
+		attr.requestHeaders = requestHeaders;
+
+		emscripten_fetch_t *fetch = emscripten_fetch(&attr, filename_.c_str());
+		if (!fetch) {
+			SetError("Unable to create browser Range request");
+			continue;
+		}
+
+		s64 responseFirst = -1;
+		s64 responseLast = -1;
+		s64 responseTotal = -1;
+		const bool rangeHeader = ParseContentRange(fetch, &responseFirst, &responseLast, &responseTotal);
+		const bool exact = fetch->status == 206 && rangeHeader && responseFirst == offset &&
+			responseLast == requestedLast && responseTotal > 0 && fetch->numBytes == length;
+		if (exact) {
+			const u8 *begin = reinterpret_cast<const u8 *>(fetch->data);
+			output->assign(begin, begin + fetch->numBytes);
+			if (totalSize)
+				*totalSize = responseTotal;
+			emscripten_fetch_close(fetch);
+			return true;
+		}
+
+		char detail[256];
+		std::snprintf(detail, sizeof(detail),
+			"Range request failed: HTTP %u, got %lld-%lld/%lld (%llu bytes), wanted %lld-%lld",
+			(unsigned)fetch->status, (long long)responseFirst, (long long)responseLast,
+			(long long)responseTotal, (unsigned long long)fetch->numBytes,
+			(long long)offset, (long long)requestedLast);
+		SetError(detail);
+		ERROR_LOG(Log::Loader, "%s", detail);
+		emscripten_fetch_close(fetch);
+	}
+	return false;
+}
+
+void WasmRangeFileLoader::Prepare() {
+	std::call_once(preparedFlag_, [this]() {
+		std::vector<u8> firstByte;
+		s64 total = 0;
+		if (!FetchRange(0, 1, &firstByte, &total) || firstByte.size() != 1 || total <= 0) {
+			fileSize_ = 0;
+			if (LatestError().empty())
+				SetError("Server did not provide a valid 206 Content-Range response");
+			return;
+		}
+		fileSize_ = total;
+	});
+}
+
+bool WasmRangeFileLoader::Exists() {
+	Prepare();
+	return fileSize_ > 0;
+}
+
+bool WasmRangeFileLoader::ExistsFast() {
+	return filename_.Type() == PathType::HTTP;
+}
+
+s64 WasmRangeFileLoader::FileSize() {
+	Prepare();
+	return fileSize_;
+}
+
+size_t WasmRangeFileLoader::ReadAt(s64 absolutePos, size_t bytes, size_t count, void *data, Flags flags) {
+	if (bytes == 0 || count == 0 || count > std::numeric_limits<size_t>::max() / bytes)
+		return 0;
+	return ReadAt(absolutePos, bytes * count, data, flags) / bytes;
+}
+
+size_t WasmRangeFileLoader::ReadAt(s64 absolutePos, size_t bytes, void *data, Flags flags) {
+	Prepare();
+	if (fileSize_ <= 0 || absolutePos < 0 || absolutePos >= fileSize_ || bytes == 0 || !data)
+		return 0;
+
+	std::lock_guard<std::mutex> guard(readMutex_);
+	const s64 wantedEnd = std::min<s64>(fileSize_, absolutePos + (s64)bytes);
+	s64 cursor = absolutePos;
+	size_t written = 0;
+
+	while (cursor < wantedEnd && !cancelled_.load()) {
+		const s64 blockStart = (cursor / BLOCK_BYTES) * BLOCK_BYTES;
+		const size_t blockLength = (size_t)std::min<s64>(BLOCK_BYTES, fileSize_ - blockStart);
+		std::vector<u8> transient;
+		const std::vector<u8> *block = nullptr;
+
+		auto found = cache_.find(blockStart);
+		if (found != cache_.end()) {
+			found->second.usedAt = ++clock_;
+			block = &found->second.bytes;
+		} else {
+			s64 observedSize = 0;
+			if (!FetchRange(blockStart, blockLength, &transient, &observedSize))
+				break;
+			if (observedSize != fileSize_) {
+				SetError("Remote disc changed size while it was being read");
+				break;
+			}
+
+			if ((flags & Flags::HINT_UNCACHED) != 0) {
+				block = &transient;
+			} else {
+				while (cachedBytes_ + transient.size() > MAX_CACHE_BYTES && !cache_.empty()) {
+					auto oldest = std::min_element(cache_.begin(), cache_.end(), [](const auto &a, const auto &b) {
+						return a.second.usedAt < b.second.usedAt;
+					});
+					cachedBytes_ -= oldest->second.bytes.size();
+					cache_.erase(oldest);
+				}
+				cachedBytes_ += transient.size();
+				auto inserted = cache_.emplace(blockStart, CacheEntry{std::move(transient), ++clock_});
+				block = &inserted.first->second.bytes;
+			}
+		}
+
+		const size_t inside = (size_t)(cursor - blockStart);
+		const size_t available = block->size() > inside ? block->size() - inside : 0;
+		const size_t take = std::min<size_t>(available, (size_t)(wantedEnd - cursor));
+		if (take == 0) {
+			SetError("Range block was shorter than requested");
+			break;
+		}
+		std::memcpy(reinterpret_cast<u8 *>(data) + written, block->data() + inside, take);
+		cursor += (s64)take;
+		written += take;
+	}
+
+	return written;
+}
+
+#endif  // __EMSCRIPTEN__
