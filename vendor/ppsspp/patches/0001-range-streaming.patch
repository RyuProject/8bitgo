diff --git a/Core/FileLoaders/WasmRangeFileLoader.h b/Core/FileLoaders/WasmRangeFileLoader.h
new file mode 100644
index 0000000..768a594
--- /dev/null
+++ b/Core/FileLoaders/WasmRangeFileLoader.h
@@ -0,0 +1,76 @@
+// Copyright (c) 2012- PPSSPP Project.
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#ifdef __EMSCRIPTEN__
+
+#include <atomic>
+#include <mutex>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+#include "Common/File/Path.h"
+#include "Core/Loaders.h"
+
+// Browser-only random-access loader.  A PSP ISO is commonly larger than the
+// WebAssembly heap budget, so retaining or downloading the entire object is
+// deliberately forbidden.  Reads are aligned to fixed 2 MiB HTTP ranges and
+// held in a bounded in-memory LRU.  Every request after the first one is also
+// pinned to the first response validator so two object versions can never be
+// mixed into one emulated disc.
+class WasmRangeFileLoader : public FileLoader {
+public:
+	explicit WasmRangeFileLoader(const Path &filename);
+	~WasmRangeFileLoader() override = default;
+
+	bool IsRemote() override { return true; }
+	bool Exists() override;
+	bool ExistsFast() override;
+	bool IsDirectory() override { return false; }
+	s64 FileSize() override;
+	Path GetPath() const override { return filename_; }
+
+	size_t ReadAt(s64 absolutePos, size_t bytes, size_t count, void *data, Flags flags = Flags::NONE) override;
+	size_t ReadAt(s64 absolutePos, size_t bytes, void *data, Flags flags = Flags::NONE) override;
+
+	void Cancel() override { cancelled_.store(true); }
+	std::string LatestError() const override;
+
+private:
+	struct CacheEntry {
+		std::vector<u8> bytes;
+		u64 usedAt = 0;
+	};
+
+	static constexpr s64 BLOCK_BYTES = 2 * 1024 * 1024;
+	// PPSSPP's pthread build reserves a 512 MiB shared heap.  A 192 MiB cache left
+	// too little headroom for textures/JIT on mobile; 96 MiB still keeps 48 blocks.
+	static constexpr size_t MAX_CACHE_BYTES = 96 * 1024 * 1024;
+
+	void Prepare();
+	bool FetchRange(s64 offset, size_t length, std::vector<u8> *output, s64 *totalSize);
+	void SetError(const std::string &message);
+	void ReportProgress(size_t bytes, s64 totalSize);
+	void ReportFatalError(const std::string &message);
+
+	Path filename_;
+	s64 fileSize_ = 0;
+	std::once_flag preparedFlag_;
+	std::atomic<bool> cancelled_{false};
+	std::atomic<bool> fatalReported_{false};
+	std::atomic<u64> downloadedBytes_{0};
+	std::string validatorName_;
+	std::string validatorValue_;
+
+	std::mutex readMutex_;
+	std::unordered_map<s64, CacheEntry> cache_;
+	size_t cachedBytes_ = 0;
+	u64 clock_ = 0;
+
+	mutable std::mutex errorMutex_;
+	std::string latestError_;
+};
+
+#endif  // __EMSCRIPTEN__
