+static void ReportWasmPerformance() {
+	static int framesUntilReport = 300;
+	if (--framesUntilReport > 0)
+		return;
+	framesUntilReport = 300;
+	float vps = 0.0f;
+	float fps = 0.0f;
+	float actualFps = 0.0f;
+	__DisplayGetFPS(&vps, &fps, &actualFps);
+	MAIN_THREAD_ASYNC_EM_ASM({
+		const callback = globalThis.__ppssppPerformance;
+		if (typeof callback === 'function') {
+			callback({
+				vps: $0,
+				fps: $1,
+				actualFps: $2,
+				canvasWidth: Module['canvas']?.width || 0,
+				canvasHeight: Module['canvas']?.height || 0,
+				audioMode: Module['__ppssppAudioMode'] || 'pending',
+			});
+		}
+	}, vps, fps, actualFps);
+}
