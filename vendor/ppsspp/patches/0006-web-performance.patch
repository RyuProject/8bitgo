diff --git a/Core/Config.cpp b/Core/Config.cpp
index 522ccae..8640b7f 100644
--- a/Core/Config.cpp
+++ b/Core/Config.cpp
@@ -413,6 +413,13 @@ static int DefaultInternalResolution() {
 	// Auto on Windows and Linux, 2x on large screens and iOS, 1x elsewhere.
 #if defined(USING_WIN_UI) || defined(USING_QT_UI)
 	return 0;
+#elif defined(__EMSCRIPTEN__)
+	// Web 外壳会把无意义的 Retina 后备缓冲限制到 PSP 的整数倍。阈值不能继续沿用
+	// 桌面窗口的 1000px，否则 960×544 的高性能档反而退回 1x 内部渲染。
+	int longestDisplaySide = std::max(System_GetPropertyInt(SYSPROP_DISPLAY_XRES), System_GetPropertyInt(SYSPROP_DISPLAY_YRES));
+	int scale = longestDisplaySide >= 900 ? 2 : 1;
+	INFO_LOG(Log::G3D, "Web display side: %d pixels. Choosing scale %d", longestDisplaySide, scale);
+	return scale;
 #elif PPSSPP_PLATFORM(IOS)
 	return 2;
 #else
