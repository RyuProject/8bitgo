+}
+
+void CPs2VmJs::BootArcade(std::string id)
+{
+	m_mailBox.SendCall([this, id]() {
+		try
+		{
+			ArcadeUtils::BootArcadeMachine(this, id + ".arcadedef");
+		}
+		catch(const std::exception& ex)
+		{
+			// 异步邮箱不会把 C++ 异常传回 JS；用 stderr 让适配器能在首帧超时前给出可读错误。
+			fprintf(stderr, "[play-boot-error] %s\n", ex.what());
+			Resume();
+		}
+	});
+}
