# 服务器公网 IPv4，SRS 必须把这个地址放进 ICE candidate。
SRS_PUBLIC_IP=203.0.113.10

# 与 server/.env 的 LIVE_SRS_HOOK_SECRET 一致；使用独立随机值，不要提交真实密钥。
SRS_HOOK_SECRET=replace-with-64-hex-characters

# Docker 容器回调到宿主机的 8BitGo API。仅本机原生 systemd 安装时改为 127.0.0.1:8788。
SRS_HOOK_ORIGIN=host.docker.internal:8788

# Compose 只在宿主机回环地址发布 API；容器内部仍监听所有接口。
SRS_HTTP_API_LISTEN=1985
