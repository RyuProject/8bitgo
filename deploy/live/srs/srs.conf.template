listen              1935;
max_connections     1000;
daemon              off;
srs_log_tank        console;

http_api {
    enabled on;
    listen __SRS_HTTP_API_LISTEN__;
}

http_server {
    enabled off;
}

rtc_server {
    enabled on;
    listen 8000;
    protocol all;
    candidate __SRS_PUBLIC_IP__;
    tcp {
        enabled on;
        listen 8000;
    }
}

vhost __defaultVhost__ {
    rtc {
        enabled on;
    }
    http_hooks {
        enabled on;
        on_publish http://__SRS_HOOK_ORIGIN__/api/live/srs-hook?key=__SRS_HOOK_SECRET__;
        on_unpublish http://__SRS_HOOK_ORIGIN__/api/live/srs-hook?key=__SRS_HOOK_SECRET__;
        on_play http://__SRS_HOOK_ORIGIN__/api/live/srs-hook?key=__SRS_HOOK_SECRET__;
        on_stop http://__SRS_HOOK_ORIGIN__/api/live/srs-hook?key=__SRS_HOOK_SECRET__;
    }
}
