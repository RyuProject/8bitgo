# 这台服务器的公网 IP（WebRTC ICE 与 TURN 都要用）
PUBLIC_IP=1.2.3.4

# TURN 密码（随便一串随机字符）：openssl rand -hex 16
TURN_SECRET=change-me

# 视频编码：vp8（默认，兼容性最好）或 vp9
VIDEO_CODEC=vp8

# ROM 同步（sync-roms.sh）
R2_REMOTE=r2
R2_BUCKET=8bitgo
R2_PREFIX=roms

# 8BG 解包需要和主站 server/.env 相同的根密钥。轮换到 v2 时同时保留 V1，规则与主站一致。
ROM_PACK_KEY_ID=v1
ROM_PACK_SECRET=replace-with-the-same-random-secret-as-main-api
# ROM_PACK_SECRET_V1=
# ROM_PACK_SECRET_V2=
