# ===== 8BitGo 后端配置 =====
# 复制为 .env 后填写。.env 不会进 git，也不会进前端打包。

# ----- 数据库（与 MySQL 同机时用 127.0.0.1）-----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=8bitgo

# ----- 服务 -----
PORT=8788
# 允许跨域的前端地址，逗号分隔；本地开发可用 * 。
# 例：https://8bitgo.com,https://www.8bitgo.com
ALLOWED_ORIGINS=*

# ----- 搜索引擎发现与 IndexNow -----
# 后端用它生成数据库实时游戏 sitemap 和 IndexNow URL；必须是站点公开 origin，不带路径。
PUBLIC_SITE_URL=https://8bitgo.com
# 只有显式打开才会在后台保存游戏后通知搜索引擎，防止开发机把测试 slug 提交到正式站。
INDEXNOW_ENABLED=1
# key 文件已放在 public/<key>.txt。它是公开的域名验证值，不是后台访问密码。
INDEXNOW_KEY=b8b81a59fab843acaa590586b6733da0
# 通常不需要改；留空使用 IndexNow 官方公共端点。
INDEXNOW_ENDPOINT=

# ----- 百度普通收录（API 提交）-----
# 搜索资源平台 → 普通收录 → API 提交。接口：http://data.zz.baidu.com/urls
# ⚠️ 准入密钥（token）和 IndexNow 的 key 不同，它是**私密**的，而且这个接口只有 http，
#    token 明文过网络。所以只放在这里（.env 不进 git），不要写进代码或前端。
#    泄露了就去平台点一次「更新准入密钥」换掉。
BAIDU_PUSH_ENABLED=1
BAIDU_PUSH_TOKEN=
# 提交时的 site 参数。留空则用上面的 PUBLIC_SITE_URL。
# ⚠️ 必须和搜索资源平台里**验证过的写法**完全一致 —— 带不带 www、http 还是 https
#    都算不同站点，写错的症状是接口返回 not_same_site，一条也不会收。
BAIDU_PUSH_SITE=
# 推送哪些语言版本。留空 = 只推简体中文（默认语言，裸路径如 /games/doom）。
# 为什么不全推：百度只做中文搜索，不会索引 /en、/ja 这些语言前缀页；而普通收录的
# 每日配额是站点级的、非常有限（新站常见 10~100 条/天），花在那些页面上等于白扔。
# 想加繁体：BAIDU_PUSH_LANGUAGES=zh-Hans,zh-Hant
BAIDU_PUSH_LANGUAGES=
# 通常不需要改。
BAIDU_PUSH_ENDPOINT=

# ----- 反代与限流 -----
# 决定 req.ip 拿到的是真实访客还是反代自己的地址。默认 loopback：
# 只有直连过来的是 127.0.0.1（同机 nginx）时才采信 X-Forwarded-For，
# 万一这个进程被直接暴露到公网也不会被伪造的头骗过去。
# ⚠️ Cloudflare 在 nginx 前面时，nginx 要把真实 IP 透传下来：
#     proxy_set_header X-Forwarded-For $http_cf_connecting_ip;
#   只写 $remote_addr 的话这里拿到的是 Cloudflare 边缘节点地址，按 IP 限流会失效。
TRUST_PROXY=loopback

# 发验证码的配额。这个接口不需要登录、一调就真发一封信，
# 配上 SMTP 之后不限流等于在服务器上架了台垃圾邮件发射器，域名会被拉黑。
# 按 IP 那道只有 TRUST_PROXY 配对时才准；全站那道不依赖代理配置，是最后一道防线。
# 多实例部署时状态在各自内存里，记得按实例数把上限除一下。
CODE_SEND_PER_IP_PER_HOUR=10
CODE_SEND_GLOBAL_PER_HOUR=500

# ----- 安全密钥（务必改成随机长串）-----
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# 后台登录与写操作共用的服务端密钥（Authorization: Bearer <ADMIN_TOKEN>）。
# 不要写成 VITE_ 开头，否则会被打进公开前端包。可用 `openssl rand -hex 24` 生成。
ADMIN_TOKEN=replace-with-a-long-random-key

# 游玩去重指纹的 HMAC 密钥。留空则复用 JWT_SECRET，一般不用单独设。
# 作用：一个人对一款游戏只算一次，靠的是 HMAC(账号 id) 或 HMAC(客户端 IP) ——
# 数据库里存的是摘要不是明文 IP，库被拖走也反查不回具体地址。
# ⚠️ 换掉这个值（或换掉 JWT_SECRET）等于把已有的去重记录全部作废：
#    老玩家的指纹对不上，每个人都会被重新算一次，plays 会明显往上跳。
PLAY_HASH_SECRET=

# ----- 首个管理员（可选，seed 时自动创建）-----
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NICKNAME=管理员

# ----- 邮箱验证码登录：发信 -----
# 四条通路，代码按下面的顺序自动选（src/mail.js）：
#   1) Resend                    —— 填了 RESEND_API_KEY 就走这条（目前正式环境用的是它）
#   2) Cloudflare Email Service  —— 填了 CF_ACCOUNT_ID + CF_EMAIL_TOKEN 走这条
#   3) SMTP                      —— 填了 SMTP_HOST + SMTP_USER 走这条
#   4) 都不填                     —— 验证码只打印到服务器日志（本地联调用）
# 启动日志里会写明当前用的是哪条（`[mail] 验证码走 …`），收不到验证码时先看那一行。
# 配完用 `npm run test:mail -- you@example.com` 单独测发信，不经过限流和验证码表。

# ----- 方式一：Resend（正式环境在用的就是这条）-----
# 只用 fetch，不需要装任何依赖。key 在 Resend 后台 API Keys 里建，形如 re_xxx。
#
# ⚠️ 发件域必须先在 Resend 后台完成 DNS 验证（SPF + DKIM），否则一律 403。
#    MAIL_FROM 的域名要和验证过的那个一致。
#    唯一的例外是它自带的 onboarding@resend.dev：不用验证域名，但**只能发给你注册
#    Resend 的那个邮箱**，发给别人会被 403 挡回来 —— 本地联调很好用，别拿去上线。
RESEND_API_KEY=

# ----- 方式二：Cloudflare Email Service -----
# 只用 fetch，不需要装任何依赖 —— 这也是将来后端搬进 Workers 时唯一不用重写的发信方式
# （SMTP 走的是 TCP 465，Workers 根本连不出去，只能发 HTTP）。
#
# 开通步骤：
#   1. 域名必须托管在 Cloudflare DNS（8bitgo.com 已经是了）
#   2. Dashboard -> Email Service -> Email Sending，把 8bitgo.com 走一遍 onboarding
#      （自动写 SPF / DKIM / DMARC 和用于收退信的 MX 记录，通常 5-15 分钟生效）
#   3. 建一个 API Token，权限勾 Email Sending: Edit，填到 CF_EMAIL_TOKEN
#   4. 账号 ID 在 Dashboard 右侧栏，填到 CF_ACCOUNT_ID
#
# ⚠️ 目前是公测（2026-04 起）。给任意地址发信需要 Workers 付费版（$5/月），
#    付费版每月含 3000 封，超出 $0.35 / 1000 封。
#    发给「已验证的目的地址」（你自己账号里验过的那几个）免费且不占配额 ——
#    域名 onboarding 完成前也只能发给这些地址，正好拿来联调。
#    日发送量有个不公开的上限，会随发信记录和退信率逐步放开，新域名别一上来就群发。
CF_ACCOUNT_ID=
CF_EMAIL_TOKEN=

# 发件地址。三条通路**共用**这一组，不属于上面某一节 ——
# 域名必须和你在 Resend / Cloudflare 那边验证过的那个一致，否则报发件人未验证。
# 收件人看到的是「8BitGo <noreply@8bitgo.com>」。
MAIL_FROM=noreply@8bitgo.com
MAIL_FROM_NAME=8BitGo
# 发信超时（毫秒）。发信卡住等于把一个 HTTP 请求也挂住，所以必须卡死。默认 15000
MAIL_TIMEOUT_MS=

# ----- 方式三：SMTP（备选，需要 npm i nodemailer）-----
# Cloudflare 也开了 SMTP 口，一行代码不改也能接：
#   SMTP_HOST=smtp.mx.cloudflare.net
#   SMTP_PORT=465          只支持 465 隐式 TLS；587 的 STARTTLS 和 25 都不支持
#   SMTP_USER=api_token    固定就是这九个字母，不是你的邮箱
#   SMTP_PASS=<和 CF_EMAIL_TOKEN 同一个 Token>
# 也可以填任意第三方 SMTP（腾讯企业邮、Gmail 应用专用密码等）。
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# 发件人地址。留空时用 MAIL_FROM，再留空用 SMTP_USER
SMTP_FROM=

# ----- 仅本地开发：把 Cloudflare 的接口指到别处（比如 mock 服务）-----
# 正式环境**不要填**。填了就等于把带发信权限的 Token 发给那个地址。
CF_API_BASE=

# ----- Google 登录（可选）-----
# 与前端 VITE_GOOGLE_CLIENT_ID 填同一个 OAuth 客户端 ID，用于校验前端传来的 Google 凭证。
GOOGLE_CLIENT_ID=

# ----- J2ME (.jar) 代理：把对象存储上的 Java 游戏转发到 /j2me/jar/ -----
# freej2me-web 只能从 <J2ME_PATH>jar/<文件名> 取 jar，不能直接给完整 URL，所以需要这层转发。
# 填 R2 / CDN 的公开根地址（末尾不要斜杠），与前端 VITE_ROM_BASE_URL 一致即可。
# 留空则 /j2me/jar/ 只服务 public/j2me/jar/ 里的本地文件。
ROM_BASE_URL=
ROM_PREFIX=roms

# ----- J2ME 玩家临时上传 -----
# 玩家在「玩本地 ROM」上传的 .jar 会暂存到服务器，供 freej2me-web 读取。
# 存放目录，默认 server/tmp/j2me
J2ME_TMP_DIR=
# 单个文件上限（MB）
J2ME_MAX_UPLOAD_MB=20
# 临时文件存活时间（毫秒）。前端每 2 分钟续期一次，所以只有「页面已经不在了」的
# 文件才会被清掉。浏览器崩溃 / 断网时前端通知不到，全靠这个兜底。
J2ME_TMP_TTL_MS=1800000
# 临时目录总量上限（MB），防止被当免费网盘刷爆磁盘
J2ME_TMP_TOTAL_MB=500

# ----- 缓存（站点前面挂 Cloudflare 时才有意义）-----
# SSR 页面在 Cloudflare 边缘缓存多少秒。后台改完内容最多这么久后前台才变，
# 想立刻生效就在 Cloudflare 控制台清一次缓存。默认 300。
PAGE_S_MAXAGE=300
# 公开只读接口（/api/games、/api/posts）在边缘缓存多少秒。默认 300。
API_S_MAXAGE=300

# ----- P2P 联机的 ICE / TURN（GET /api/netplay/ice 下发）-----
# 为什么需要 TURN：P2P 直连要穿 NAT，只靠 STUN 大约有一到两成的玩家组合连不通
# （对称型 NAT、部分企业网与移动网络）。配上 TURN 中继才能兜住这部分人 ——
# 只有连不通的那部分流量会过服务器，能直连的照旧点对点，不占你的带宽。
#
# ⚠️ 不要再用前端的 VITE_NETPLAY_ICE 填 TURN 密码：那会被打进 JS 包里，
#    任何人打开 DevTools 就能抄走当免费流量中转。配在这里的话，
#    服务端按请求现算一份短期凭证下发，密码永远不出服务器。
#
# coturn 侧只要：turnserver.conf 里写 use-auth-secret 和 static-auth-secret=<下面同一个值>，
# 不需要建任何用户。
# 多个地址用逗号分隔，可以同时给 turn: 和 turns:（TLS，穿透企业防火墙更稳）
TURN_URLS=
# 与 coturn 的 static-auth-secret 一致。生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TURN_SECRET=
# 单份凭证有效期（秒），默认 3600。前端会在过期前 5 分钟自动续
TURN_TTL_SEC=3600
# 额外的 STUN（逗号分隔）。留空用内置的几个公共 STUN
STUN_URLS=

# ----- 联机信令的一些上限 -----
# 同时存在的房间上限，防止公开接口被刷爆内存
NETPLAY_MAX_ROOMS=500
# 房主掉线后保留房间、等人接手的时间（毫秒）
NETPLAY_HOST_GRACE_MS=60000

# 每个房间最多几个观众（只看不玩，不占手柄位）。
# 观众也是房主那台机器的一条 WebRTC 上行流 —— 家宽上行大约撑到十来路，所以默认给 12。
NETPLAY_MAX_SPECTATORS=12

# ----- 云存档（routes/saves.js）-----
# 云存档必须登录，存档跟着账号走。没登录的玩家存在自己浏览器里或者下载成文件，不进数据库。
# 单份存档上限。GBA 内存快照几十 KB、DOS 变更包几百 KB，4MB 很宽裕
SAVE_MAX_BYTES=4194304
# 每人最多存多少份，防止有人拿它当网盘
SAVE_MAX_PER_USER=200

# ----- DOS 联机（js-dos 的 IPX 中继，见 server/src/ipx.js）-----
# 开启后在主站同一个端口上提供 /ipx/<房间>（前提是 js-dos 打过补丁，
# scripts/copy-jsdos.mjs 复制资源时会自动打）。
IPX_ENABLED=0
# 只有在用未打补丁的原版 js-dos 时才需要：设成 1900 会退回独立端口模式。
# 注意 Cloudflare 橙云代理不了 1900，那种情况得单开灰云子域名，见 README。
# IPX_PORT=1900
# 只是填进 IPX 头里给 DOSBox 看的标识，不影响连通性
IPX_PUBLIC_HOST=ipx
