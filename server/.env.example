# ===== 8BitGo 后端配置 =====
# 复制为 .env 后填写。.env 不会进 git，也不会进前端打包。

# ----- 数据库（与 MySQL 同机时用 127.0.0.1）-----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=8bitgo

# ----- 服务 -----
PORT=8788
# 允许跨域的前端地址，逗号分隔；本地开发可用 * 。
# 例：https://8bitgo.com,https://www.8bitgo.com
ALLOWED_ORIGINS=*

# ----- 安全密钥（务必改成随机长串）-----
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# 后台写操作口令（Authorization: Bearer <ADMIN_TOKEN>）。与前端「后台 → ROM 存储 / 数据」里填的口令一致。
ADMIN_TOKEN=change-me-too

# ----- 首个管理员（可选，seed 时自动创建）-----
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NICKNAME=管理员

# ----- 邮箱验证码登录：发信 SMTP（可选）-----
# 不填则验证码只打印到服务器日志（本地联调用）。真实发信需要：npm i nodemailer 并填下面几项。
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# 发件人地址，默认用 SMTP_USER
SMTP_FROM=

# ----- Google 登录（可选）-----
# 与前端 VITE_GOOGLE_CLIENT_ID 填同一个 OAuth 客户端 ID，用于校验前端传来的 Google 凭证。
GOOGLE_CLIENT_ID=

# ----- J2ME (.jar) 代理：把对象存储上的 Java 游戏转发到 /j2me/jar/ -----
# freej2me-web 只能从 <J2ME_PATH>jar/<文件名> 取 jar，不能直接给完整 URL，所以需要这层转发。
# 填 R2 / CDN 的公开根地址（末尾不要斜杠），与前端 VITE_ROM_BASE_URL 一致即可。
# 留空则 /j2me/jar/ 只服务 public/j2me/jar/ 里的本地文件。
ROM_BASE_URL=
ROM_PREFIX=roms

# ----- J2ME 玩家临时上传 -----
# 玩家在「玩本地 ROM」上传的 .jar 会暂存到服务器，供 freej2me-web 读取。
# 存放目录，默认 server/tmp/j2me
J2ME_TMP_DIR=
# 单个文件上限（MB）
J2ME_MAX_UPLOAD_MB=20
# 临时文件存活时间（毫秒）。前端每 2 分钟续期一次，所以只有「页面已经不在了」的
# 文件才会被清掉。浏览器崩溃 / 断网时前端通知不到，全靠这个兜底。
J2ME_TMP_TTL_MS=1800000
# 临时目录总量上限（MB），防止被当免费网盘刷爆磁盘
J2ME_TMP_TOTAL_MB=500
