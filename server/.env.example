# ===== 8BitGo 后端配置 =====
# 复制为 .env 后填写。.env 不会进 git，也不会进前端打包。

# ----- 数据库（与 MySQL 同机时用 127.0.0.1）-----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=8bitgo

# ----- 服务 -----
PORT=8788
# 允许跨域的前端地址，逗号分隔；本地开发可用 * 。
# 例：https://8bitgo.com,https://www.8bitgo.com
ALLOWED_ORIGINS=*

# ----- 安全密钥（务必改成随机长串）-----
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# 后台写操作口令（Authorization: Bearer <ADMIN_TOKEN>）。与前端「后台 → ROM 存储 / 数据」里填的口令一致。
ADMIN_TOKEN=change-me-too

# ----- 首个管理员（可选，seed 时自动创建）-----
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NICKNAME=管理员

# ----- 邮箱验证码登录：发信 SMTP（可选）-----
# 不填则验证码只打印到服务器日志（本地联调用）。真实发信需要：npm i nodemailer 并填下面几项。
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# 发件人地址，默认用 SMTP_USER
SMTP_FROM=

# ----- Google 登录（可选）-----
# 与前端 VITE_GOOGLE_CLIENT_ID 填同一个 OAuth 客户端 ID，用于校验前端传来的 Google 凭证。
GOOGLE_CLIENT_ID=

# ----- J2ME (.jar) 代理：把对象存储上的 Java 游戏转发到 /j2me/jar/ -----
# freej2me-web 只能从 <J2ME_PATH>jar/<文件名> 取 jar，不能直接给完整 URL，所以需要这层转发。
# 填 R2 / CDN 的公开根地址（末尾不要斜杠），与前端 VITE_ROM_BASE_URL 一致即可。
# 留空则 /j2me/jar/ 只服务 public/j2me/jar/ 里的本地文件。
ROM_BASE_URL=
ROM_PREFIX=roms

# ----- J2ME 玩家临时上传 -----
# 玩家在「玩本地 ROM」上传的 .jar 会暂存到服务器，供 freej2me-web 读取。
# 存放目录，默认 server/tmp/j2me
J2ME_TMP_DIR=
# 单个文件上限（MB）
J2ME_MAX_UPLOAD_MB=20
# 临时文件存活时间（毫秒）。前端每 2 分钟续期一次，所以只有「页面已经不在了」的
# 文件才会被清掉。浏览器崩溃 / 断网时前端通知不到，全靠这个兜底。
J2ME_TMP_TTL_MS=1800000
# 临时目录总量上限（MB），防止被当免费网盘刷爆磁盘
J2ME_TMP_TOTAL_MB=500

# ----- 缓存（站点前面挂 Cloudflare 时才有意义）-----
# SSR 页面在 Cloudflare 边缘缓存多少秒。后台改完内容最多这么久后前台才变，
# 想立刻生效就在 Cloudflare 控制台清一次缓存。默认 300。
PAGE_S_MAXAGE=300
# 公开只读接口（/api/games、/api/posts）在边缘缓存多少秒。默认 300。
API_S_MAXAGE=300

# ----- P2P 联机的 ICE / TURN（GET /api/netplay/ice 下发）-----
# 为什么需要 TURN：P2P 直连要穿 NAT，只靠 STUN 大约有一到两成的玩家组合连不通
# （对称型 NAT、部分企业网与移动网络）。配上 TURN 中继才能兜住这部分人 ——
# 只有连不通的那部分流量会过服务器，能直连的照旧点对点，不占你的带宽。
#
# ⚠️ 不要再用前端的 VITE_NETPLAY_ICE 填 TURN 密码：那会被打进 JS 包里，
#    任何人打开 DevTools 就能抄走当免费流量中转。配在这里的话，
#    服务端按请求现算一份短期凭证下发，密码永远不出服务器。
#
# coturn 侧只要：turnserver.conf 里写 use-auth-secret 和 static-auth-secret=<下面同一个值>，
# 不需要建任何用户。
# 多个地址用逗号分隔，可以同时给 turn: 和 turns:（TLS，穿透企业防火墙更稳）
TURN_URLS=
# 与 coturn 的 static-auth-secret 一致。生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TURN_SECRET=
# 单份凭证有效期（秒），默认 3600。前端会在过期前 5 分钟自动续
TURN_TTL_SEC=3600
# 额外的 STUN（逗号分隔）。留空用内置的几个公共 STUN
STUN_URLS=

# ----- 联机信令的一些上限 -----
# 同时存在的房间上限，防止公开接口被刷爆内存
NETPLAY_MAX_ROOMS=500
# 房主掉线后保留房间、等人接手的时间（毫秒）
NETPLAY_HOST_GRACE_MS=60000

# 每个房间最多几个观众（只看不玩，不占手柄位）。
# 观众也是房主那台机器的一条 WebRTC 上行流 —— 家宽上行大约撑到十来路，所以默认给 12。
NETPLAY_MAX_SPECTATORS=12

# ----- DOS 联机（js-dos 的 IPX 中继，见 server/src/ipx.js）-----
# 开启后在主站同一个端口上提供 /ipx/<房间>（前提是 js-dos 打过补丁，
# scripts/copy-jsdos.mjs 复制资源时会自动打）。
IPX_ENABLED=0
# 只有在用未打补丁的原版 js-dos 时才需要：设成 1900 会退回独立端口模式。
# 注意 Cloudflare 橙云代理不了 1900，那种情况得单开灰云子域名，见 README。
# IPX_PORT=1900
# 只是填进 IPX 头里给 DOSBox 看的标识，不影响连通性
IPX_PUBLIC_HOST=ipx
