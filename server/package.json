    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mmdb-lib": "^3.0.3",
    "mysql2": "^3.11.0",
    "nodemailer": "^6.9.14",
    "socket.io": "^4.8.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "esbuild": "^0.23.0",
    "socket.io-client": "^4.8.1"
