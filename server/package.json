{
  "name": "8bitgo-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "8BitGo 后端 API：连接 MySQL，为前端提供游戏 / 博客 / 用户接口",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "migrate": "node scripts/migrate.mjs",
    "seed": "node scripts/seed.mjs",
    "reset-fake-data": "node scripts/reset-fake-data.mjs",
    "test:db": "node scripts/test-connection.mjs",
    "test:mail": "node scripts/test-mail.mjs",
    "test:mail:parse": "node scripts/test-mail-parsing.mjs",
    "test:mail:resend": "node scripts/test-mail-resend.mjs",
    "test:codes": "node scripts/test-codes.mjs",
    "test:presence": "node scripts/test-presence.mjs",
    "test:roles": "node scripts/test-roles.mjs",
    "test:play": "node scripts/test-playcount.mjs",
    "gen-sql": "node scripts/gen-sql.mjs",
    "gen-sql:empty": "node scripts/gen-sql.mjs --empty",
    "backfill-search": "node scripts/backfill-search.mjs",
