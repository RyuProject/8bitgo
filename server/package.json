{
  "name": "8bitgo-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "8BitGo 后端 API：连接 MySQL，为前端提供游戏 / 博客 / 用户接口",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "migrate": "node scripts/migrate.mjs",
    "seed": "node scripts/seed.mjs",
    "reset-fake-data": "node scripts/reset-fake-data.mjs",
    "test:db": "node scripts/test-connection.mjs",
    "gen-sql": "node scripts/gen-sql.mjs",
    "gen-sql:empty": "node scripts/gen-sql.mjs --empty",
    "backfill-search": "node scripts/backfill-search.mjs",
    "test:search": "node scripts/test-search.mjs",
    "test:search:db": "node scripts/test-search-db.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.0",
    "nodemailer": "^6.9.14",
    "socket.io": "^4.8.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "esbuild": "^0.23.0",
    "socket.io-client": "^4.8.1"
  }
}
