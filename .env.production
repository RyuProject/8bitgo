# 生产构建的前端变量（vite build 时自动加载；npm run dev 不读这个文件）。
#
# 为什么要有这个文件：这些值以前只写在 .env.local 里，而 .env.local 被
# .gitignore 的 *.local 挡在仓库外 —— 服务器上 git pull 下来的代码里根本没有它，
# npm run build 出来的产物就悄悄少了这些配置：EmulatorJS 退回 CDN 旧版（街机全挂）、
# og:image / canonical 缺域名、封面拼不出地址。本地怎么试都是好的，线上是坏的，
# 查了很多轮才定位到。所以：**凡是构建期要用的、又不是机密的值，都写在这里进 git**。
#
# 这里全是公开信息（域名、公开桶地址），本来就会被编译进前端产物，没有泄密问题。
# 真正的机密（JWT_SECRET、数据库口令）在 server/.env，那个永远不进 git。
#
# 注意 Vite 的优先级：.env.production 高于 .env.local（构建时）。
# 本地想覆盖这里的值做实验，用 .env.production.local（已被忽略）。

# 后端与前端同源，由同一个 Express 进程提供，API 走相对路径 /api/…
VITE_API_URL=same-origin

# 正式域名。canonical、og:url、hreflang、sitemap 全靠它
VITE_SITE_URL=https://8bitgo.com

VITE_SITE_NAME=8BitGo

# 对象存储（R2）的公开读取根地址：把 covers/xxx.jpg 这类对象 key 拼成完整 URL
VITE_ROM_BASE_URL=https://assets.8bitgo.com

# ── P2P 联机（默认方案）───────────────────────────────────────────────
# 信令服务器地址。**不配这个，整块联机功能是隐藏的** —— netplayEnabled() 恒为 false，
# 房间列表不会去连，模拟器里的联机按钮也不显示。之前线上 /rooms 永远是空列表就是因为漏了它。
#
# 填 /netplay：信令由本站后端同一个 Express 进程提供（server/src/index.js 的 attachNetplay，
# 命名空间 io.of('/netplay')），所以走相对路径就行 —— socket.io 客户端把 io('/netplay')
# 理解成「当前源的 /netplay 命名空间」，房间列表 /api/netplay/rooms 也跟着走相对路径，
# 换域名、上 CDN 都不用重新构建。前后端不同域时才填绝对地址（https://api.你的域名/netplay）。
# ⚠️ 上面这句只对父页面成立：模拟器 iframe 是 srcdoc（location 是 about:srcdoc），socket.io 拿相对地址
# 会拼成 http://about:80/… 被 Mixed Content 拦掉，所以交给 iframe 的那份由代码先解析成绝对地址
# （src/services/netplay.ts 的 netplayUrlForFrame），这里照旧填相对路径即可。
VITE_NETPLAY_URL=/netplay

# ICE 服务器（JSON 数组）。留空 = 只用公共 STUN，约一到两成的网络组合（对称型 NAT、
# 部分企业网 / 移动网）连不通。生产环境建议在后端 .env 里配 TURN（TURN_URL / TURN_SECRET，
# 见 server/src/routes/ice.js）——那样凭证是现签的短期凭证，不会打进前端包里。
VITE_NETPLAY_ICE=

# ── 云端联机（cloud-game，付费通道）─────────────────────────────────
# 游戏跑在服务器上，每个房间占一个 CPU 核，需要另外部署 cloud-game（见 deploy/cloudgame/）。
# 没部署就留空/注释掉 —— 配了个连不上的地址，播放器里的「联机模式」会点了报错。
# VITE_CLOUDGAME_URL=https://cg.8bitgo.com

# Worker 接口：后台上传、删除、列表使用，与玩家公开读取域名分开。
VITE_ROM_API_URL=https://roms.8bitgo.com

# Java 手机游戏的 FreeJ2ME 运行时。prebuild 会自动安装到 public/j2me/。
# 这是构建期开关：只写在服务器环境里会让本地与线上产物不一致。
VITE_J2ME_PATH=/j2me/

# VITE_EJS_PATH 不用配：代码默认 /emulatorjs/（见 src/emulator/adapters/emulatorjs.ts）
