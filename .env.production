# 生产构建的前端变量（vite build 时自动加载；npm run dev 不读这个文件）。
#
# 为什么要有这个文件：这些值以前只写在 .env.local 里，而 .env.local 被
# .gitignore 的 *.local 挡在仓库外 —— 服务器上 git pull 下来的代码里根本没有它，
# npm run build 出来的产物就悄悄少了这些配置：EmulatorJS 退回 CDN 旧版（街机全挂）、
# og:image / canonical 缺域名、封面拼不出地址。本地怎么试都是好的，线上是坏的，
# 查了很多轮才定位到。所以：**凡是构建期要用的、又不是机密的值，都写在这里进 git**。
#
# 这里全是公开信息（域名、公开桶地址），本来就会被编译进前端产物，没有泄密问题。
# 真正的机密（JWT_SECRET、数据库口令）在 server/.env，那个永远不进 git。
#
# 注意 Vite 的优先级：.env.production 高于 .env.local（构建时）。
# 本地想覆盖这里的值做实验，用 .env.production.local（已被忽略）。

# 后端与前端同源，由同一个 Express 进程提供，API 走相对路径 /api/…
VITE_API_URL=same-origin

# 正式域名。canonical、og:url、hreflang、sitemap 全靠它
VITE_SITE_URL=https://8bitgo.com

VITE_SITE_NAME=8BitGo

# 对象存储（R2）的公开读取根地址：把 covers/xxx.jpg 这类对象 key 拼成完整 URL
VITE_ROM_BASE_URL=https://assets.8bitgo.com

# VITE_EJS_PATH 不用配：代码默认 /emulatorjs/（见 src/emulator/adapters/emulatorjs.ts）
