{
  "manifest_version": 2,
  "name": "8BitGo PokeCatch Save Bridge",
  "version": "1.1.0",
  "description": "在 Safari 的 Pokecatch 游戏标签页与 8BitGo 账号云存档之间交接游戏进度。",
  "permissions": [
    "storage",
    "tabs",
    "https://8bitgo.com/*",
    "https://cn.8bitgo.com/*",
    "https://pokecatch-online.netlify.app/*"
  ],
  "background": {
    "scripts": ["background.safari.js"],
    "persistent": false
  },
  "browser_action": {
    "default_title": "8BitGo PokeCatch 存档桥",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://8bitgo.com/pokecatch-save-sync*",
        "https://8bitgo.com/*/pokecatch-save-sync*",
        "https://cn.8bitgo.com/pokecatch-save-sync*",
        "https://cn.8bitgo.com/*/pokecatch-save-sync*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://pokecatch-online.netlify.app/*"],
      "js": ["game-main.safari.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["https://pokecatch-online.netlify.app/*"],
      "js": ["game-bridge.safari.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
