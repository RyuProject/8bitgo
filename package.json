{
  "name": "8bitgo",
  "private": true,
  "version": "0.9.18",
  "type": "module",
  "scripts": {
    "predev": "node scripts/fetch-fonts.mjs --if-missing && node scripts/copy-ruffle.mjs --if-missing && node scripts/copy-jsdos.mjs --if-missing --with-dosbox-x && node scripts/setup-j2me.mjs --if-missing",
    "dev": "vite",
    "start": "vite",
    "fonts": "node scripts/fetch-fonts.mjs",
    "ruffle": "node scripts/copy-ruffle.mjs",
    "jsdos": "node scripts/copy-jsdos.mjs --with-dosbox-x",
    "prebuild": "node scripts/fetch-fonts.mjs --if-missing && node scripts/copy-ruffle.mjs --if-missing && node scripts/copy-jsdos.mjs --if-missing --with-dosbox-x && node scripts/setup-j2me.mjs --if-missing && node scripts/check-emulatorjs.mjs && node scripts/gen-sitemap.mjs",
    "build": "tsc -b && npm run build:client && npm run build:server",
    "lint": "oxlint",
    "preview": "vite preview",
    "sitemap": "node scripts/gen-sitemap.mjs",
    "indexnow": "npm --prefix server run indexnow",
    "baidu": "cd server && node scripts/submit-baidu.mjs",
    "test:jsnes": "node scripts/test-jsnes-audio.mjs",
    "test:lang": "node scripts/test-lang-detect.mjs",
    "test:age": "node scripts/test-age-gate.mjs",
    "test:dos-backend": "node scripts/test-dos-backend.mjs",
    "test:romdata": "node scripts/test-romdata.mjs",
    "test:indexnow": "node scripts/test-indexnow.mjs",
    "test:baidu": "node scripts/test-baidu-push.mjs",
    "test:roms": "node scripts/test-rom-validation.mjs",
    "test:romcache": "node scripts/test-rom-cache.mjs",
    "test:rom-probe": "node --experimental-strip-types --import ./scripts/helpers/ts-register.mjs scripts/test-rom-probe.mjs",
    "test:multipart": "node scripts/test-worker-multipart.mjs",
    "build:client": "vite build",
    "postbuild:client": "node scripts/check-emulatorjs.mjs --dist",
    "build:server": "vite build --config vite.config.server.ts",
    "start:ssr": "node server/src/index.js",
    "j2me": "node scripts/setup-j2me.mjs",
    "webretro": "node scripts/setup-webretro.mjs",
    "ejscores": "node scripts/copy-ejs-cores.mjs",
    "ejspatch": "node scripts/patch-emulatorjs.mjs",
    "romsets": "node scripts/build-arcade-romsets.mjs",
    "romdata": "node scripts/make-romdata.mjs"
  },
  "dependencies": {
    "jsnes": "^2.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@ruffle-rs/ruffle": "^0.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "esbuild": "^0.28.2",
    "js-dos": "^8.4.1",
    "oxlint": "^1.79.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "wrangler": "^4.126.0"
  }
}
